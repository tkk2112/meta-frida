#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$repo_root"

kas_config="dev/kas/server.yml"

case "${1:-}" in
    "")
        ;;
    core)
        kas_config+=":dev/kas/smoketest/core.yml"
        ;;
    *)
        echo "Usage: dev/scripts/qemu [core]" >&2
        exit 2
        ;;
esac

dev/scripts/yocto build "$kas_config"

exec dev/scripts/yocto shell "$kas_config" \
    -c 'exec runqemu qemuarm64 core-image-minimal nographic slirp snapshot'
