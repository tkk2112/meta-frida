#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(
    cd -- "$(dirname -- "$0")" &&
        pwd
)"

# shellcheck source=lib/bootstrap.sh
source "$SCRIPT_DIR/lib/bootstrap.sh"

root="$ROOT"
image="$YOCTO_IMAGE"
work_volume="$YOCTO_WORK_VOLUME"

if [[ -n "${CONTAINER_ENGINE:-}" ]]; then
    engine="$CONTAINER_ENGINE"
elif command -v podman >/dev/null 2>&1; then
    engine=podman
elif command -v docker >/dev/null 2>&1; then
    engine=docker
else
    echo "error: neither podman nor docker was found in PATH" >&2
    exit 1
fi

runtime_args=()

if [[ "$(basename "$engine")" == "podman" ]]; then
    runtime_args+=(--security-opt label=disable)
fi

"$engine" build \
    --build-arg "KAS_VERSION=$KAS_VERSION" \
    -t "$image" \
    -f "$root/dev/containers/yocto/Dockerfile" \
    "$root"

if ! "$engine" volume inspect "$work_volume" >/dev/null 2>&1; then
    "$engine" volume create "$work_volume" >/dev/null
fi

builder_record="$(
    "$engine" run \
        --rm \
        "${runtime_args[@]}" \
        --entrypoint /usr/bin/getent \
        "$image" \
        passwd builder
)"

if [[ -z "$builder_record" ]]; then
    echo "error: $image does not contain the expected 'builder' user" >&2
    exit 1
fi

IFS=: read -r _ _ builder_uid builder_gid _ builder_home _ <<<"$builder_record"

if [[ ! "$builder_uid" =~ ^[0-9]+$ || ! "$builder_gid" =~ ^[0-9]+$ ]]; then
    echo "error: unable to determine builder UID/GID from:" >&2
    echo "  $builder_record" >&2
    exit 1
fi

kas_path="$(
    "$engine" run \
        --rm \
        "${runtime_args[@]}" \
        --entrypoint /bin/sh \
        "$image" \
        -c 'command -v kas'
)"

if [[ -z "$kas_path" ]]; then
    echo "error: unable to locate kas in $image" >&2
    exit 1
fi

"$engine" run \
    --rm \
    "${runtime_args[@]}" \
    --user 0:0 \
    --entrypoint /bin/sh \
    -v "$work_volume:/work:rw" \
    "$image" \
    -ec "chown $builder_uid:$builder_gid /work"

"$engine" run \
    --rm \
    "${runtime_args[@]}" \
    --user "$builder_uid:$builder_gid" \
    --entrypoint /bin/sh \
    -e "HOME=$builder_home" \
    -v "$work_volume:/work:rw" \
    "$image" \
    -ec '
        touch /work/.meta-frida-write-test
        rm /work/.meta-frida-write-test
    '

exec "$engine" run \
    --rm \
    --init \
    "${runtime_args[@]}" \
    --user "$builder_uid:$builder_gid" \
    --entrypoint "$kas_path" \
    -e "HOME=$builder_home" \
    -e USER=builder \
    -e LOGNAME=builder \
    -e KAS_WORK_DIR=/work \
    -e GIT_CONFIG_COUNT=1 \
    -e GIT_CONFIG_KEY_0=safe.directory \
    -e GIT_CONFIG_VALUE_0=/repo \
    -v "$root:/repo:ro" \
    -v "$work_volume:/work:rw" \
    -w /repo \
    "$image" \
    "$@"
