set -a
source dev/config/tooling.env
set +a

watch_file dev/config/tooling.env
watch_file "$UV_PROJECT/pyproject.toml"
watch_file "$UV_PROJECT/uv.lock"

if ! has uv; then
    log_error "uv: command not found"
    return 1
fi

uv sync \
    --project "$UV_PROJECT" \
    --python "$PYTHON_VERSION" \
    --frozen

PATH_add "$UV_PROJECT"
PATH_add "$UV_PROJECT/.venv/bin"

if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    hook_path="$(git rev-parse --git-path hooks/pre-commit)"

    if [ ! -f "$hook_path" ] || ! grep -q 'pre-commit' "$hook_path"; then
        uv run --project dev/scripts --frozen pre-commit install
    fi
fi
