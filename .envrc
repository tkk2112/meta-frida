export UV_PROJECT=$PWD/dev/scripts
export UV_FROZEN=1
export UV_PYTHON="${UV_PYTHON:-3.14}"

watch_file $UV_PROJECT/.python-version $UV_PROJECT/pyproject.toml $UV_PROJECT/uv.lock

PATH_add $UV_PROJECT

if ! has uv; then
  log_error "uv: command not found. Install from https://docs.astral.sh/uv/"
  return 1
fi

local venv_path
venv_path="$(expand_path "$UV_PROJECT/.venv")"
export UV_PROJECT_ENVIRONMENT="$venv_path"

uv sync
export VIRTUAL_ENV="$venv_path"
if [[ -d "$venv_path/bin" ]]; then
  PATH_add "$venv_path/bin"
fi
if [[ -d "$venv_path/Scripts" ]]; then
  PATH_add "$venv_path/Scripts"
fi
